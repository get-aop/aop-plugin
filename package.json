{
  "name": "@get-aop/aop-plugin",
  "version": "0.1.0",
  "description": "AOP software delivery workflow plugin for DeepSeek Harness — automated Plan -> Implementation -> Review -> Browser QA loops",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    }
  },
  "dsh": {
    "client": "./lib/client/index.js"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=lib/index.js --external:@deepseek-ai/* --external:react --external:react/jsx-runtime",
    "prepare": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "aop",
    "agents-operating-platform",
    "deepseek-harness",
    "cordis",
    "workflow",
    "agent-loop",
    "software-delivery",
    "browser-qa",
    "ui"
  ],
  "author": "AOP contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-aop/aop-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/get-aop/aop-plugin/issues"
  },
  "homepage": "https://getaop.com",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^3.0.0 || ^4.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.0.0",
    "typescript": "^5.8.0 || ^6.0.0"
  }
}
