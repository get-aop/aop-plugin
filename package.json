{
  "name": "@get-aop/dsh-plugin",
  "version": "0.1.0",
  "description": "AOP software delivery workflow plugin for DeepSeek Harness — automated Plan -> Implementation -> Review -> Browser QA loops",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "aop",
    "agents-operating-platform",
    "deepseek-harness",
    "cordis",
    "workflow",
    "agent-loop",
    "software-delivery",
    "browser-qa"
  ],
  "author": "AOP contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-aop/aop-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/get-aop/aop-plugin/issues"
  },
  "homepage": "https://getaop.com",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^3.0.0 || ^4.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@types/bun": "^1.3.14",
    "typescript": "^5.8.0 || ^6.0.0"
  }
